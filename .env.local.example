# Скопируйте этот файл в .env.local и заполните своими значениями.

# --- Telegram: уведомления о заявках ---
# 1. Откройте в Telegram @BotFather -> /newbot -> следуйте шагам -> скопируйте токен
# 2. Напишите новому боту любое сообщение (например "старт")
# 3. Откройте в браузере: https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
#    В ответе найдите "chat":{"id": ЧИСЛО, ...} — это и есть TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Яндекс.Метрика: аналитика ---
# 1. Создайте счётчик: https://metrika.yandex.ru/
# 2. Включите «Вебвизор, карта скроллинга, аналитика форм»
# 3. Скопируйте сюда номер счётчика (только цифры, например 98765432)
# Без этой переменной аналитика просто не подключается, сайт работает как обычно.
NEXT_PUBLIC_YM_COUNTER_ID=

# --- Meta Pixel: отслеживание заявок для рекламы в Instagram/Facebook ---
# 1. Откройте https://business.facebook.com/events_manager
# 2. «Подключить источники данных» -> «Веб» -> создайте пиксель
# 3. Скопируйте сюда ID пикселя (только цифры)
NEXT_PUBLIC_FB_PIXEL_ID=
