# Скопируйте этот файл в .env.local и заполните своими значениями.
# Как получить:
# 1. Откройте в Telegram @BotFather -> /newbot -> следуйте шагам -> скопируйте токен
# 2. Напишите новому боту любое сообщение (например "старт")
# 3. Откройте в браузере: https://api.telegram.org/bot<ВАШ_ТОКЕН>/getUpdates
#    В ответе найдите "chat":{"id": ЧИСЛО, ...} — это и есть TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
