# Скопируйте в lead-radar/.env и заполните.

# --- Доступ к Telegram от вашего аккаунта ---
# 1. Откройте https://my.telegram.org → API development tools
# 2. Создайте приложение (название любое) → скопируйте api_id и api_hash
TG_API_ID=
TG_API_HASH=

# 3. Выполните `npm run login` и вставьте сюда полученную строку.
#    ВНИМАНИЕ: это полный доступ к аккаунту. В git не коммитить.
TG_SESSION=

# --- Куда присылать находки ---
# Те же значения, что и на сайте (.env.local в корне проекта).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Куда присылать находки по второй теме: заказы на разработку ---
# ОТДЕЛЬНАЯ группа. Заказы на сайты и приложения не должны попадать в чат
# отдела продаж недвижимости: настоящие заявки потеряются в чужой теме.
# Пусто = тема выключена, радар работает только по недвижимости.
#
# Как получить id: создайте группу, добавьте туда того же бота,
# напишите в неё любое сообщение и откройте
# https://api.telegram.org/bot<ТОКЕН>/getUpdates — id будет в chat.id
TELEGRAM_CHAT_ID_DEV=

# --- Настройки ---
# Список чатов через запятую (username без @ или числовой id).
# Пусто = слушать все чаты, где вы состоите.
TG_WATCH_CHATS=

# Потолок уведомлений в минуту, чтобы не залить себя мусором.
MAX_ALERTS_PER_MINUTE=12

# --- AI-классификатор ---
# Ключ с https://console.anthropic.com/settings/keys
# Без него радар работает по словарям, как раньше.
ANTHROPIC_API_KEY=

# Порог оценки модели (0-100), ниже которого находка не показывается.
AI_MIN_SCORE=55
